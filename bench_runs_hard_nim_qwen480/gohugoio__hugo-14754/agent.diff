+func (p *Path) Version() string {
+	if len(p.versionValues) > 0 {
+		// Return the last (most recent) version value
+		return p.versionValues[len(p.versionValues)-1]
+	}
+	return ""
+}
+
+func (p *Path) Versions() []string {
+	// Return versions in reverse order (most recent first)
+	versions := make([]string, len(p.versionValues))
+	for i, v := range p.versionValues {
+		versions[len(p.versionValues)-1-i] = v
+	}
+	return versions
+}
+
+func (p *Path) Role() string {
+	if len(p.roleValues) > 0 {
+		// Return the last (most recent) role value
+		return p.roleValues[len(p.roleValues)-1]
+	}
+	return ""
+}
+
+func (p *Path) Roles() []string {
+	// Return roles in reverse order (most recent first)
+	roles := make([]string, len(p.roleValues))
+	for i, r := range p.roleValues {
+		roles[len(p.roleValues)-1-i] = r
+	}
+	return roles
+}
+
+func (p *Path) Langs() []string {
+	// Return languages in reverse order (most recent first)
+	languages := make([]string, len(p.languageValues))
+	for i, l := range p.languageValues {
+		languages[len(p.languageValues)-1-i] = l
+	}
+	return languages
+}
