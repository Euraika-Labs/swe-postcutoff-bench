+// WarnDeprecatedEdition warns about deprecated editions.
+func WarnDeprecatedEdition() {
+	if IsExtended && !IsWithdeploy {
+		loggers.Log().Info().Logf("the extended edition of the Hugo executable is deprecated. Use the standard edition instead")
+	} else if IsExtended && IsWithdeploy {
+		loggers.Log().Info().Logf("the extended_withdeploy edition of the Hugo executable is deprecated. Use the withdeploy edition instead")
+	}
+}
