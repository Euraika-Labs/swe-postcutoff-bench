+func (p *Path) Role() string {
+	return p.identifierAsString(p.posIdentifierRole)
+}
+
+func (p *Path) Roles() []string {
+	ids := make([]string, 0, len(p.identifiersKnown))
+	for i, id := range p.identifiersKnown {
+		if id.Low > 0 && p.s[id.Low-1] == '_' && p.s[id.High] == '_' {
+			if p.posIdentifierRole == i {
+				continue
+			}
+			role := strings.TrimPrefix(p.s[id.Low+1:id.High-1], "_role_")
+			role = strings.TrimSuffix(role, "_")
+			ids = append(ids, role)
+		}
+	}
+	return ids
+}
