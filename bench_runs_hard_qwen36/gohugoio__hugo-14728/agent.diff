+// WarnDeprecatedEdition logs a deprecation warning if running
+// an extended or extended_withdeploy edition.
+func WarnDeprecatedEdition() {
+	if !IsExtended {
+		return
+	}
+	var item, alternative string
+	if IsWithdeploy {
+		item = "the extended_withdeploy edition of the Hugo executable"
+		alternative = "Use the withdeploy edition instead"
+	} else {
+		item = "the extended edition of the Hugo executable"
+		alternative = "Use the standard edition instead"
+	}
+	deprecateLevel(item, alternative, "", logg.LevelWarn)
+}
