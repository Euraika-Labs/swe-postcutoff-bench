+// WarnDeprecatedEdition warns about depreacted the extended and extended_withDeploy editions.
+func WarnDeprecatedEdition() {
+	if !IsExtended {
+		return
+	}
+
+	deprecationVersion := "0.160.0"
+	level := deprecationLogLevelFromVersion(deprecationVersion)
+
+	if IsWithdeploy {
+		deprecateLevel("the extended_withdeploy edition of the Hugo executable", "Use the withdeploy edition instead", deprecationVersion, level)
+	} else {
+		deprecateLevel("the extended edition of the Hugo executable", "Use the standard edition instead", deprecationVersion, level)
+	}
+}
