+// tryParsePrefixIdentifier attempts to parse sid as a prefix-form wrapped identifier
+// like _<prefix>_<value>_, where <prefix> is one of: language, version, role, kind,
+// outputformat, layout. Returns true if parsed and registered.
+func (pp *PathParser) tryParsePrefixIdentifier(component string, p *Path, id types.LowHigh[string], sid string) bool {
+	// sid must already be _<...>_.
+	innerRel := strings.IndexByte(sid[1:], '_')
+	if innerRel == -1 {
+		return false
+	}
+	innerRel++ // adjust to position relative to start of sid
+	if innerRel >= len(sid)-1 {
+		// inner _ would coincide with the trailing _.
+		return false
+	}
+	prefix := strings.ToLower(sid[1:innerRel])
+	value := sid[innerRel+1 : len(sid)-1]
+	if value == "" {
+		return false
+	}
+	innerSep := id.Low + innerRel
+
+	appendID := func() {
+		p.identifiersKnown = append(p.identifiersKnown, id)
+		p.identifiersInnerSep = append(p.identifiersInnerSep, innerSep)
+	}
+
+	switch prefix {
+	case "language":
+		if component != files.ComponentFolderContent && component != files.ComponentFolderLayouts {
+			return false
+		}
+		if pp.LanguageIndex != nil {
+			if _, ok := pp.LanguageIndex[strings.ToLower(value)]; !ok {
+				if pp.IsLangDisabled != nil && pp.IsLangDisabled(strings.ToLower(value)) {
+					p.disabled = true
+				}
+			}
+		}
+		appendID()
+		if p.posIdentifierLanguage == -1 {
+			p.posIdentifierLanguage = len(p.identifiersKnown) - 1
+		}
+		return true
+	case "version":
+		appendID()
+		if p.posIdentifierVersion == -1 {
+			p.posIdentifierVersion = len(p.identifiersKnown) - 1
+		}
+		return true
+	case "role":
+		appendID()
+		if p.posIdentifierRole == -1 {
+			p.posIdentifierRole = len(p.identifiersKnown) - 1
+		}
+		return true
+	case "kind":
+		if component != files.ComponentFolderLayouts {
+			return false
+		}
+		if kinds.GetKindMain(strings.ToLower(value)) == "" {
+			return false
+		}
+		appendID()
+		p.posIdentifierKind = len(p.identifiersKnown) - 1
+		return true
+	case "outputformat":
+		if component != files.ComponentFolderLayouts {
+			return false
+		}
+		appendID()
+		p.posIdentifierOutputFormat = len(p.identifiersKnown) - 1
+		return true
+	case "layout":
+		if component != files.ComponentFolderLayouts {
+			return false
+		}
+		if p.posIdentifierLayout != -1 {
+			// Move existing to unknown.
+			p.identifiersUnknown = append(p.identifiersUnknown, p.identifiersKnown[p.posIdentifierLayout])
+			p.identifiersKnown[p.posIdentifierLayout] = id
+			p.identifiersInnerSep[p.posIdentifierLayout] = innerSep
+		} else {
+			appendID()
+			p.posIdentifierLayout = len(p.identifiersKnown) - 1
+		}
+		return true
+	}
+	return false
+}
