+// computeSkipDots scans the last path component of s for `._<...>_`
+// wrappers and returns the positions of any '.' characters inside such
+// wrappers. Those dots must not be processed as identifier separators
+// (e.g. inside _version_v1.0.0_).
+func computeSkipDots(s string, lastSlashIdx int) map[int]bool {
+	var skip map[int]bool
+	fnStart := lastSlashIdx + 1
+	for i := fnStart; i < len(s); {
+		if s[i] != '.' || i+1 >= len(s) || s[i+1] != '_' {
+			i++
+			continue
+		}
+		// Look for a closing `_` that is followed by `.` or end-of-string.
+		closeAt := -1
+		for j := i + 2; j < len(s); j++ {
+			if s[j] == '_' && (j+1 == len(s) || s[j+1] == '.') {
+				closeAt = j
+				break
+			}
+		}
+		if closeAt == -1 {
+			i++
+			continue
+		}
+		for k := i + 2; k < closeAt; k++ {
+			if s[k] == '.' {
+				if skip == nil {
+					skip = make(map[int]bool)
+				}
+				skip[k] = true
+			}
+		}
+		i = closeAt + 1
+	}
+	return skip
+}
