+// identifierPrefix returns the wrapper prefix (lowercased) for the i-th
+// identifier, or "" if the identifier is not a wrapped prefix identifier.
+func (p *Path) identifierPrefix(i int) string {
+	if i < 0 || i >= len(p.identifiersInnerSep) {
+		return ""
+	}
+	sep := p.identifiersInnerSep[i]
+	if sep == -1 {
+		return ""
+	}
+	id := p.identifiersKnown[i]
+	if sep <= id.Low || sep >= id.High {
+		return ""
+	}
+	return strings.ToLower(p.s[id.Low+1 : sep])
+}
