+func (p *Path) identifierValuesByPrefix(prefix string, fallbackPos int) []string {
+	var result []string
+	for i := range p.identifiersKnown {
+		switch p.identifierPrefix(i) {
+		case prefix:
+			result = append(result, p.identifierAsString(i))
+		case "":
+			if i == fallbackPos {
+				result = append(result, p.identifierAsString(i))
+			}
+		}
+	}
+	return result
+}
