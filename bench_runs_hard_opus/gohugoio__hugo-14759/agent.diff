+// DecodePermalinksConfig decodes the permalinks configuration. It accepts
+// both the legacy map-based formats and the new slice-based format with
+// PageMatcher targets.
+func DecodePermalinksConfig(in any) (PermalinksConfig, error) {
+	if in == nil {
+		return nil, nil
+	}
+
+	// New slice format: [[permalinks]] target/pattern.
+	switch v := in.(type) {
+	case []any:
+		return decodePermalinksSlice(v)
+	case []map[string]any:
+		s := make([]any, len(v))
+		for i, m := range v {
+			s[i] = m
+		}
+		return decodePermalinksSlice(s)
+	}
+
+	// Legacy map formats.
+	m, err := toStringMap(in)
+	if err != nil {
+		return nil, err
+	}
+	if m == nil {
+		return nil, nil
+	}
+	return decodePermalinksMap(m)
+}
+
+func toStringMap(in any) (map[string]any, error) {
+	switch v := in.(type) {
+	case nil:
+		return nil, nil
+	case map[string]any:
+		return v, nil
+	case hmaps.Params:
+		return v, nil
+	}
+	return hmaps.ToStringMap(in), nil
+}
 
