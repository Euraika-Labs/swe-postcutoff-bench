+func (m PageMatcher) Equal(other PageMatcher) bool {
+	return m.Path == other.Path &&
+		m.Kind == other.Kind &&
+		m.Lang == other.Lang &&
+		m.Environment == other.Environment &&
+		m.Sites.Equal(other.Sites) &&
