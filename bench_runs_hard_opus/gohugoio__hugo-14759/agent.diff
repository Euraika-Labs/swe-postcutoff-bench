+// legacyKeyToPath translates an old-style section/taxonomy key into a path glob
+// that matches the same set of pages.
+func legacyKeyToPath(key, kind string) string {
+	key = strings.Trim(key, sectionCutSet)
+	if key == "" {
+		return ""
+	}
+	key = strings.ToLower(filepath.ToSlash(key))
+	switch kind {
+	case kinds.KindHome:
+		return "/" + key
+	case kinds.KindSection, kinds.KindTaxonomy:
+		return "/{" + key + "," + key + "/**}"
+	}
+	return "/" + key + "/**"
