+// compileGlobs compiles the glob patterns in the PageMatcher.
+// This should be called before Matches to avoid repeated glob compilation.
+func (m *PageMatcher) compileGlobs() error {
+	if m.Kind != "" {
+		g, err := hglob.GetGlob(m.Kind)
+		if err != nil {
+			return err
+		}
+		m.KindCompiled = &GlobPattern{pattern: m.Kind, glob: g}
+	}
+
+	if m.Path != "" {
+		g, err := hglob.GetGlob(m.Path)
+		if err != nil {
+			return err
+		}
+		m.PathCompiled = &GlobPattern{pattern: m.Path, glob: g}
+	}
+
+	if m.Environment != "" {
+		g, err := hglob.GetGlob(m.Environment)
+		if err != nil {
+			return err
+		}
+		m.EnvironmentCompiled = &GlobPattern{pattern: m.Environment, glob: g}
+	}
+
+	return nil
+}
