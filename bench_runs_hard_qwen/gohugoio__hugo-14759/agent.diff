+// GlobPattern represents a compiled glob pattern.
+type GlobPattern struct {
+	pattern string
+	glob    hglob.Glob
+}
+
+func (gp *GlobPattern) compile(pattern string) error {
+	g, err := hglob.GetGlob(pattern)
+	if err != nil {
+		return err
+	}
+	gp.pattern = pattern
+	gp.glob = g
+	return nil
+}
+
+func (gp *GlobPattern) Match(s string) bool {
+	if gp.glob == nil {
+		return true
+	}
+	return gp.glob.Match(s)
+}
