+// ExpandSlice expands the path in p according to the slice-based permalinks config.
+// It matches the Page against all the slice configs and returns the first match.
+func (l PermalinkExpander) ExpandSlice(p Page) (string, error) {
+	// First try the slice-based configs
+	for _, entry := range l.sliceConfigs {
+		if entry.Target.Match(p.Kind(), p.Path(), p.Site().Hugo().Environment(), nil) {
+			return l.ExpandPattern(entry.Pattern, p)
+		}
+	}
+
+	// Fall back to legacy map-based configs if no slice match
+	expanders, found := l.expanders[p.Kind()]
+	if !found {
+		return "", nil
+	}
+
+	// For legacy format, use the section as the key
+	section := p.Section()
+	expand, found := expanders[section]
+	if !found {
+		return "", nil
+	}
+
+	return expand(p)
+}
