diff --git a/markup/goldmark/toc_passthrough_test.go b/markup/goldmark/toc_passthrough_test.go
new file mode 100644
index 000000000..279e46207
--- /dev/null
+++ b/markup/goldmark/toc_passthrough_test.go
@@ -0,0 +1,28 @@
+package goldmark_test
+
+import (
+	"testing"
+
+	"github.com/gohugoio/hugo/hugolib"
+)
+
+func TestPassthroughInTocDebug(t *testing.T) {
+	files := `
+-- hugo.toml --
+disableKinds = ['page','rss','section','sitemap','taxonomy','term']
+[markup.goldmark.extensions.passthrough]
+  enable = true
+[markup.goldmark.extensions.passthrough.delimiters]
+  inline = [['$', '$']]
+-- content/_index.md --
+---
+title: home
+---
+## Heading with $a$
+-- layouts/home.html --
+{{ .TableOfContents }}
+`
+
+	b := hugolib.Test(t, files)
+	b.AssertFileContent("public/index.html", `<li><a href="#heading-with-a">Heading with $a$</a></li>`)
+}
