+// Version returns the version identifier value (without the "_version_" prefix).
+// If multiple versions are specified, returns the rightmost one (last parsed).
+func (p *Path) Version() string {
+	s := p.identifierAsString(p.posIdentifierVersion)
+	if strings.HasPrefix(s, "_version_") && strings.HasSuffix(s, "_") && len(s) > len("_version_")+1 {
+		return s[len("_version_") : len(s)-1]
+	}
+	return s
+}
+
+// Role returns the role identifier value (without the "_role_" prefix).
+// If multiple roles are specified, returns the rightmost one (last parsed).
+func (p *Path) Role() string {
+	s := p.identifierAsString(p.posIdentifierRole)
+	if strings.HasPrefix(s, "_role_") && strings.HasSuffix(s, "_") && len(s) > len("_role_")+1 {
+		return s[len("_role_") : len(s)-1]
+	}
+	return s
+}
+
+// Langs returns all language identifiers in the order they were parsed (right-to-left).
+func (p *Path) Langs() []string {
+	langs := make([]string, len(p.posIdentifierLanguages))
+	for i, idx := range p.posIdentifierLanguages {
+		langs[i] = p.identifierAsString(idx)
+	}
+	return langs
+}
+
+// Roles returns all role identifier values (without the "_role_" prefix) in the order they were parsed (right-to-left).
+func (p *Path) Roles() []string {
+	roles := make([]string, len(p.posIdentifierRoles))
+	for i, idx := range p.posIdentifierRoles {
+		s := p.identifierAsString(idx)
+		if strings.HasPrefix(s, "_role_") && strings.HasSuffix(s, "_") && len(s) > len("_role_")+1 {
+			roles[i] = s[len("_role_") : len(s)-1]
+		} else {
+			roles[i] = s
+		}
+	}
+	return roles
+}
+
+// Versions returns all version identifier values (without the "_version_" prefix) in the order they were parsed (right-to-left).
+func (p *Path) Versions() []string {
+	versions := make([]string, len(p.posIdentifierVersions))
+	for i, idx := range p.posIdentifierVersions {
+		s := p.identifierAsString(idx)
+		if strings.HasPrefix(s, "_version_") && strings.HasSuffix(s, "_") && len(s) > len("_version_")+1 {
+			versions[i] = s[len("_version_") : len(s)-1]
+		} else {
+			versions[i] = s
+		}
+	}
+	return versions
+}
