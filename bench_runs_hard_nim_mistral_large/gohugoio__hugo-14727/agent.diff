+
+// getSitesMatrixForRootSection returns an appropriate sites matrix for creating root sections.
+// For multilingual sites, it creates root sections for all languages when at least one
+// language has content in that section. This ensures consistent section hierarchy
+// across all languages in multilingual sites.
+func (a *allPagesAssembler) getSitesMatrixForRootSection(rootSection, base string) sitesmatrix.SitesMatrix {
+	// Check if this section exists in any language
+	if _, err := a.pwRoot.WalkContext.GetOK(rootSection); err == nil {
+		// Section exists in at least one language, create for all languages
+		return a.h.Conf.AllSitesMatrix()
+	}
+
+	// Use the current site vectors
+	return nil
+}
